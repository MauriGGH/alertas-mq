# Copia este archivo a .env y ajusta valores
PORT=3000
KAFKA_BROKERS=localhost:9092
POSTGRES_PASSWORD=alertas
DATABASE_URL=postgres://alertas:alertas@localhost:5432/alertas

# Token del túnel (Cloudflare Zero Trust > Networks > Tunnels > tu túnel)
CF_TUNNEL_TOKEN=

# ---- Fase 2 ----
# Genera valores con: openssl rand -hex 32
JWT_SECRET=
ADMIN_TOKEN=
# URL pública del túnel (se usa en logs y herramientas)
PUBLIC_URL=https://api.tudominio.com
