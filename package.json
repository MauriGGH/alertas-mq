{
  "name": "alertas-mq",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "tunnel:up": "docker compose --profile tunnel up -d cloudflared",
    "dev:server": "npm -w @alertas/server run dev",
    "smoke": "npm -w @alertas/server run smoke",
    "typecheck": "tsc -p apps/server --noEmit",
    "client": "npm -w @alertas/server run client --",
    "alert": "npm -w @alertas/server run alert --",
    "quake": "npm -w @alertas/server run quake --"
  },
  "engines": {
    "node": ">=20"
  }
}
